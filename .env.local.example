# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets here.

HTTPS=true
SSL_CRT_FILE=certificate.crt
SSL_KEY_FILE=private.key

FACE_COMPARE_URL=https://api-us.faceplusplus.com/facepp/v3/compare
FACE_API_SEARCH=https://api-us.faceplusplus.com/facepp/v3/search
FACE_API_KEY=
FACE_API_SECRET=
FACESET_OUTER_ID=
FACE_CONFIDENCE_THRESHOLD=60.0

SUPABASE_FACE_BUCKET=face-images
SUPABASE_UPLOAD_BUCKET=uploads

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role/secret key — Supabase dashboard > Project Settings > API >
# service_role (or the new "secret" key type). Server-only, bypasses RLS.
SUPABASE_SECRET_KEY=

# Signs the admin bearer token issued at login for officers with role
# "admin". Any random 32+ byte string, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN_SECRET=

# Optional — only needed for /api/notification/send-email
MAIL_USER=
MAIL_PASS=

# Optional — Wirepick SMS (lib/sendsms.ts), not currently wired to a route
WIREPICK_CLIENT=
WIREPICK_PASSWORD=
WIREPICK_SENDER_ID=
